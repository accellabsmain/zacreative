# ==============================================================================
# Zacreative Environment Variables Template
# Copy this file to .env.local for local development.
# In Vercel, add these under Project Settings -> Environment Variables.
# ==============================================================================

# Site URL (Canonical URL for SEO, sitemap, metadata, and JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Contact Number (Format: 628xxxxxxxxxx without + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=628xxxx

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=zacreative2026
AUTH_SECRET=your-random-long-secret-key-min-32-chars

# Vercel Blob Storage (for synced Instagram / portfolio data and media)
BLOB_READ_WRITE_TOKEN=

