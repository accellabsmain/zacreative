datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model InstagramPost {
  id          String   @id @default(uuid())
  igPostId    String   @unique
  caption     String?  @db.Text
  permalink   String
  publishedAt DateTime
  slides      Json
  createdAt   DateTime @default(now())

  @@index([publishedAt])
}

